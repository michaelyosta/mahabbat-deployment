# Canonical application is fetched at bootstrap and is intentionally not vendored.
/mahabbat-app/

# Twenty fork checkout is materialized by mahabbat-fetch-fork.ps1, not vendored.
/mahabbat-twenty/

# Compiled installer output is built locally, not committed.
/installer/build/output/

# Local secrets and runtime state
.env
.env.*
!.env.example
/.private/
.cloudflared/
*.pem
*.key
*.token

# PostgreSQL recovery artifacts are local-only.
/backups/
/recovery/

# Portable/private restaurant bridge packages are built locally and are never
# a source-controlled deployment artifact. The private ZIP contains a local
# HMAC configuration and must remain outside Git.
/artifacts/

# Tooling output
.DS_Store
*.log
