# Mahabbat deployment template. Keep the populated .env local and untracked.
# Venue identity: visible name plus optional public Cloudflare endpoints.
# Leave the public URLs and tunnel name empty for a LAN-only venue PC.
MAHABBAT_VENUE_NAME=Махаббат
MAHABBAT_TUNNEL_NAME=
MAHABBAT_PUBLIC_CRM_URL=
MAHABBAT_PUBLIC_POS_URL=
PRINT_GATEWAY_ID=
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=<generate-a-new-local-password>
PG_DATABASE_NAME=default
PG_DATABASE_HOST=db
PG_DATABASE_PORT=5432

SERVER_URL=http://localhost:3000
REDIS_URL=redis://redis:6379
STORAGE_TYPE=local
LOGIC_FUNCTION_TYPE=LOCAL
ENCRYPTION_KEY=<generate-a-new-64-character-hex-key>
FALLBACK_ENCRYPTION_KEY=
APP_SECRET=<generate-a-new-local-secret>
MAHABBAT_INTERNAL_ROUTE_SECRET=<generate-a-new-local-secret>
MAHABBAT_PRINT_GATEWAY_URL=http://host.docker.internal:3110
FRONT_AUTO_BASE_URL=true

# Leave empty until a local Twenty API credential is provisioned after first login.
TWENTY_API_KEY=
MAHABBAT_API_KEY=
TWENTY_APP_ACCESS_TOKEN=

POS_GATEWAY_PORT=3100
# Mahabbat P1: same-origin by default (empty). Set explicit origins
# (comma-separated) when the POS UI is served from another origin.
POS_CORS_ORIGIN=
# Host-side gateway mode: LOCAL starts this host gateway; REMOTE leaves print
# dispatch to the temporary restaurant gateway. It reads Windows printer queues and keeps the shared
# internal route secret; it never exposes this secret to the browser.
PRINT_GATEWAY_MODE=LOCAL
PRINT_GATEWAY_HOST=0.0.0.0
PRINT_GATEWAY_PORT=3110

# Optional acceptance-only values. Never commit real PINs.
MAHABBAT_POS_SEED_WAITER_PIN=
MAHABBAT_POS_SEED_ADMIN_PIN=
MAHABBAT_POS_PIN_A=
MAHABBAT_POS_PIN_B=
MAHABBAT_REVIEW_ADMIN_PIN=
MAHABBAT_REVIEW_NAMESPACE=INV-HR-YYYYMMDD-FRESH
MAHABBAT_POS_SESSION_IDLE_MINUTES=15

# Official named tunnel token is not needed by Compose and must never be committed.
# Store it only in a local secure file when installing cloudflared as a service.

# Mahabbat P1: POS PIN-lookup HMAC secret (fail-closed — POS login refuses to
# run without it outside dev/test). Generate a new local secret; never commit.
MAHABBAT_PIN_LOOKUP_SECRET=<generate-a-new-local-secret>
# Emergency/dev bypass only. Never 'true' in production.
MAHABBAT_ALLOW_INSECURE_PIN_LOOKUP=
# Mahabbat P1: single-venue signup gates (fail-closed defaults shown).
MAHABBAT_REQUIRE_PERSONAL_INVITE_FOR_PASSWORD_SIGNUP=true
# SSO signup invite mode: 'personal-or-public' relaxes the personal-invite
# gate for Google/Microsoft SSO (documented risk acceptance).
MAHABBAT_SSO_SIGNUP_INVITE_MODE=
# POS gateway POST body cap (bytes) and per-IP+terminal bucket.
POS_GATEWAY_MAX_BODY_BYTES=32768
POS_GATEWAY_BUCKET_CAPACITY=30
POS_GATEWAY_BUCKET_WINDOW_MS=60000
# Backup root OUTSIDE the installed app tree (uninstall never wipes backups).
# Default: %ProgramData%\Mahabbat\backups. Retention: newest N copies kept.
MAHABBAT_BACKUP_ROOT=
# Image pull policy for pinned db/redis (missing = pull only when absent).
# Server/worker/pos-gateway resolve GHCR-first via MAHABBAT_IMAGE_OWNER
# (lowercase GitHub owner); local build stays as compose fallback when the
# registry image is absent or pull fails.
# Full-image overrides (rare: pinning digest or staging registry):
# MAHABBAT_TWENTY_IMAGE=ghcr.io/<owner-lower>/mahabbat-twenty:v2.29.0-venue
# MAHABBAT_POS_IMAGE=ghcr.io/<owner-lower>/mahabbat-pos-gateway:v2.29.0-venue
MAHABBAT_IMAGE_OWNER=
MAHABBAT_TWENTY_IMAGE=
MAHABBAT_POS_IMAGE=
MAHABBAT_PULL_POLICY=missing
