{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mahabbat release manifest",
  "description": "Single release identity for a Mahabbat venue release: Mahabbat version, deployment/CRM SHAs, upstream pin, per-artifact image digests, host-script hashes, backup version, metadata migrations. Stage D owns this file; stage E fills exeSha256/changelogSource.",
  "type": "object",
  "required": [
    "mahabbatVersion",
    "windowsFileVersion",
    "deploymentSha",
    "crmSha",
    "upstreamPin",
    "images",
    "hostScriptsHash",
    "backupVersion",
    "metadataMigrations"
  ],
  "properties": {
    "mahabbatVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-rc\\.[0-9]+)?$" },
    "windowsFileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "deploymentSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "deploymentBranch": { "type": "string" },
    "crmSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "crmPending": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branch", "sha", "reason"],
        "properties": {
          "branch": { "type": "string" },
          "sha": { "type": "string" },
          "reason": { "type": "string" },
          "status": { "type": "string", "enum": ["open-awaiting-crm-tsc", "merged"] },
          "expectedIn": { "type": "string" },
          "mergedInto": { "type": "string" }
        }
      }
    },
    "crmMerged": {
      "type": "array",
      "description": "Retired pending entries, kept as an explicit record so a pending SHA can never vanish silently. An entry lands here only when its sha is contained in the enforced crmSha.",
      "items": {
        "type": "object",
        "required": ["branch", "sha", "mergedInto", "status", "reason"],
        "properties": {
          "branch": { "type": "string" },
          "sha": { "type": "string" },
          "mergedInto": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "status": { "type": "string", "const": "merged" },
          "reason": { "type": "string" }
        }
      }
    },
    "crmNext": {
      "type": "object",
      "description": "Prepared (not yet enforced) CRM bump: new inner SHA, its distinct immutable tags, and the fixup procedure. The enforced triple (inner lock commit, digests-lock tags, release crmSha) does NOT move until crmNext.gate is green. Old immutable tag names are never reused for new content.",
      "required": ["sha", "short", "status", "gate", "images", "fixup"],
      "properties": {
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "short": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
        "status": { "type": "string", "const": "prepared-awaiting-crm-tsc" },
        "gate": { "type": "string" },
        "note": { "type": "string" },
        "images": {
          "type": "object",
          "required": ["branding", "venue", "posGateway"],
          "properties": {
            "branding": { "$ref": "#/definitions/nextArtifact" },
            "venue": { "$ref": "#/definitions/nextArtifact" },
            "posGateway": { "$ref": "#/definitions/nextArtifact" }
          }
        },
        "fixup": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "digestFixup": {
      "type": "array",
      "description": "Post-publish procedure filling TBD image digests (v2: rename-then-resolve — names embed the publish HEAD dep12, so the fixup recomputes names first, then resolves digests, then writes names+digests+deploymentSha; the fixup commit touches only the manifest+lock and never retriggers publish). Present while any enforced images.*.digest is the TBD sentinel; executed once per release after CI publishes the immutable tags. Only the manifest digest/tag/deploymentSha fields move in that fixup.",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "retiredImmutableTags": {
      "type": "array",
      "description": "Frozen publish-once names superseded by the enforced images.*.immutableTag set: kept in GHCR untouched, never republished, overwritten or reused. Historical record only — no consumer may resolve through these.",
      "items": {
        "type": "object",
        "required": ["tag", "digest", "status"],
        "properties": {
          "tag": { "type": "string", "pattern": "^sha-[0-9a-f]{12}-(branding|venue|pos-gateway)$" },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "type": "string", "const": "retired-frozen" },
          "note": { "type": "string" }
        }
      }
    },
    "upstreamPin": {
      "type": "object",
      "required": ["repository", "ref", "commit", "image", "digest"],
      "properties": {
        "repository": { "type": "string" },
        "ref": { "type": "string" },
        "commit": { "type": "string" },
        "image": { "type": "string" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "images": {
      "type": "object",
      "required": ["branding", "venue", "posGateway"],
      "properties": {
        "branding": { "$ref": "#/definitions/artifact" },
        "venue": { "$ref": "#/definitions/artifact" },
        "posGateway": { "$ref": "#/definitions/artifact" }
      }
    },
    "hostScriptsHash": {
      "type": "object",
      "required": ["algorithm", "files"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "note": { "type": "string" },
        "files": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }
    },
    "backupVersion": { "type": "integer", "minimum": 1 },
    "metadataMigrations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "changelogSource": { "type": "string" },
    "exeSha256": { "type": "string" }
  },
  "definitions": {
    "nextArtifact": {
      "type": "object",
      "description": "Prepared tag for not-yet-published content: publish-once v2 name (dep segment included), digest stays the explicit TBD sentinel until CI publishes the tag.",
      "required": ["immutableTag", "digest"],
      "properties": {
        "immutableTag": { "type": "string", "pattern": "^sha-[0-9a-f]{12}-[0-9a-f]{12}-(branding|venue|pos-gateway)$" },
        "digest": { "type": "string", "const": "sha256:TBD-after-publish" }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["repo", "mutableAlias", "immutableTag", "digest"],
      "properties": {
        "repo": { "type": "string" },
        "mutableAlias": { "type": "string" },
        "immutableTag": { "type": "string", "pattern": "^sha-[0-9a-f]{12}-[0-9a-f]{12}-(branding|venue|pos-gateway)$" },
        "digest": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
